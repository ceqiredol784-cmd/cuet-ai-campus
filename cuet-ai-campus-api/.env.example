# ---------------------------------------------------------------------------
# CUET AI Campus API
# Copy this file to .env and adjust for your machine.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Local MongoDB or MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/cuet_ai_campus

# Use a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public origin used when building attachment URLs. Leave empty to derive it
# from the incoming request.
PUBLIC_BASE_URL=http://localhost:3000

# Used for calendar dates, "today" and reminder/schedule calculations.
APP_TIME_ZONE=Asia/Dhaka

# Development convenience. Keep false in production.
AUTO_SEED=true

# Password assigned to every seeded demo account.
DEMO_PASSWORD=Campus123

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Optional AI provider. Without a key the API uses its deterministic,
# data-aware campus assistant.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Resend password-reset email settings.
# Add your Resend API key to the local .env file, not to source control.
RESEND_API_KEY=
RESEND_FROM_EMAIL=crazymahfuj1@gmail.com
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRES_MINUTES=15
